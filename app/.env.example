# Firebase config for the stg-fabric project.
# Copy this file to `.env` and fill in the real values from:
# Firebase Console -> Project "stg-fabric" -> Project Settings -> Your apps (Web) -> SDK config
# NOTE: `.env` holds secrets — do NOT commit it. Keep only placeholders in this example file.

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=stg-fabric.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=stg-fabric
VITE_FIREBASE_STORAGE_BUCKET=stg-fabric.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id-here
VITE_FIREBASE_APP_ID=your-app-id-here
